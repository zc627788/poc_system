# Docker Compose uses this file for deployment variables.
# Copy it to `.env` in the project root before first deployment.

APP_ENV=development

MYSQL_DATABASE=opc_portal
MYSQL_BIND=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=opc
MYSQL_PASSWORD=change-me-database-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Replace this before going online.
JWT_SECRET_KEY=change-me-with-at-least-32-random-characters

# Public site URL used by Next.js metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=http://localhost
SITE_PUBLIC_URL=http://127.0.0.1:3000

# Optional SSO adapter. Keep disabled unless valid credentials are supplied.
IXIAMEN_SSO_ENABLED=false
IXIAMEN_BASE_URI=
IXIAMEN_CLIENT_ID=
IXIAMEN_CLIENT_SECRET=
IXIAMEN_REDIRECT_URI=http://localhost/api/public/auth/ixiamen/callback
IXIAMEN_SCOPE="basic name mobile"
IXIAMEN_CHANNEL=IXM_PC
IXIAMEN_POST_LOGIN_REDIRECT=/
IXIAMEN_LOGOUT_REDIRECT_URI=http://localhost/
TEST_AUTH_BRIDGE_ENABLED=false

# Optional SMS notifications.
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=Demo Portal
SMS_APPROVED_TEMPLATE_CODE=
SMS_LICENSE_READY_TEMPLATE_CODE=
SMS_PICKUP_ADDRESS=
SMS_CONTACT_PHONE=

# 支付配置
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_ENABLED=true
MOCK_PAYMENT_SIGNING_SECRET=change-me-with-another-random-string

# Optional trusted-data-space adapter. Real credentials belong only in the deployment environment.
TRUSTED_DATASPACE_ENABLED=false
TRUSTED_DATASPACE_BASE_URL=
TRUSTED_DATASPACE_X_TOKEN=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRUSTED_DATASPACE_DATA_KEY=
TRUSTED_DATASPACE_PORTAL_URL=
TRUSTED_DATASPACE_CA_BUNDLE=
TRUSTED_DATASPACE_CONNECT_TIMEOUT_SECONDS=5
TRUSTED_DATASPACE_READ_TIMEOUT_SECONDS=15

# Admin is served by a separate port.
# Keep the admin UI local by default. Bind it to a VPN/internal interface only
# when the network and firewall rules have been reviewed.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8081

# Optional image overrides for restricted networks.
# Example: NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
NODE_IMAGE=node:22-alpine
PYTHON_IMAGE=python:3.13-slim
NGINX_IMAGE=nginx:1.27-alpine
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.4
