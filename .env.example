# Docker Compose uses this file for deployment variables.
# Copy it to `.env` in the project root before first deployment.

MYSQL_DATABASE=opc_portal
MYSQL_USER=opc
MYSQL_PASSWORD=opc123456
MYSQL_ROOT_PASSWORD=root123456

# Replace this before going online.
JWT_SECRET_KEY=replace-me-with-a-long-random-string

# Public site URL used by Next.js metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=http://localhost
